# --- core ---
# Required. development | test | production; an unset APP_ENV refuses to boot (development mounts /dev with no login).
APP_ENV=development
PORT=3000
# APP_URL=https://myapp.example.com   # required in production; in development it follows PORT (http://localhost:{PORT}), so leave it unset
DATABASE_URL=sqlite://storage/development.sqlite3?mode=rwc
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/board_development
# DATABASE_POOL=4              # default: 4 for SQLite, 10 for Postgres
# APP_WORKER_THREADS=2         # Tokio worker threads; raise for CPU-heavy request work on a bigger box
# APP_BLOCKING_THREADS=16      # cap on Tokio's blocking pool (spawn_blocking: static files, hashing)
# APP_BIND=0.0.0.0             # development listens on 127.0.0.1 only (its /dev tools have no login); a dev container opts in here. Production default: 0.0.0.0
# APP_ALLOWED_HOSTS=dev.example.com,.lan.example   # development answers only localhost and APP_URL's host (DNS rebinding); add a tunnel or LAN name ('.' = subdomains too)
# APP_TRUSTED_PROXY=true       # behind Fly, Render or any proxy: read the client IP from X-Forwarded-For (REQUIRED behind any proxy, or every user shares one rate-limit key)
# APP_TRUSTED_PROXY_HOPS=1     # proxies that append to X-Forwarded-For before the app: 1 = one platform proxy (Fly, Render), 2 = Cloudflare → Caddy → app
# APP_SHUTDOWN_DRAIN_SECS=5    # web: open connections get this long after SIGTERM; keep it below the platform's kill timeout
# APP_REVISION=               # git sha, set by the deploy (shown on /dev/system)
# --- direct TLS (optional; default: plain HTTP behind the platform's TLS proxy) ---
# APP_TLS_CERT=/etc/app/tls/cert.pem
# APP_TLS_KEY=/etc/app/tls/key.pem
# APP_DEV_HTTP_PORT=3001        # development only, with TLS on: the same app on plain http (bin/dev sets it with DEV_CERT_SELF_SIGNED=1)
# The dev dashboard (/dev/dashboard). GitHub page: the app's repo, and an optional read-only token.
GITHUB_REPO=
GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com     # GitHub Enterprise
# Production: mount the read-only /admin/dashboard (needs APP_ADMIN_PASSWORD or admin accounts).
DASHBOARD_IN_PRODUCTION=false
# APP_ADMIN_PASSWORD=                      # 16+ characters; HTTP Basic for /admin/dashboard
# Tests page (app test, Run tests): the Postgres server for the Postgres suite, nextest's target dir.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# CARGO_TARGET_DIR=target
# DASHBOARD_GITHUB_FIXTURE=tests/fixtures/github   # development only: recorded GitHub answers (the demo)
# DASHBOARD_DEMO_HISTORY=false             # development only: an hour of synthetic, marked history (the demo)
# DASHBOARD_HISTORY=true                   # charts' history and notable traces on disk (false: memory only)
# DASHBOARD_STORAGE_DIR=storage/dashboard  # the dashboard's own files (history, past Ask AI runs)
# DASHBOARD_HISTORY_PATH=storage/dashboard/history.sqlite3
# DASHBOARD_PROFILER=true                  # development, Linux/macOS: Hot functions starts CPU sampling (always: from boot; false: never)
# The browser beacon (Frontend tab: rage/dead clicks, JS errors, Web Vitals): on in development.
# DASHBOARD_RUM=false                      # production: true (needs DASHBOARD_IN_PRODUCTION); POSTs to /rum
# DASHBOARD_RUM_SAMPLE=0.1                 # the share of page views that load it (production default 0.1)
# "Ask AI" on the dashboard (optional, your own key; development only unless DASHBOARD_AI_IN_PRODUCTION).
# DASHBOARD_AI_PROVIDER=anthropic          # or openai-compatible (OpenAI, Ollama, LM Studio, a gateway)
# DASHBOARD_AI_API_KEY=                    # never shown, logged or stored; optional for a local model
# DASHBOARD_AI_MODEL=claude-sonnet-5-5     # Anthropic default; claude-opus-5-5 (deeper), claude-haiku-5-5 (cheaper)
# DASHBOARD_AI_BASE_URL=https://api.anthropic.com   # https, or http://localhost:11434/v1 (Ollama)
# DASHBOARD_AI_IN_PRODUCTION=false         # also in the read-only /admin/dashboard, behind its gate
# DASHBOARD_AI_PROACTIVE=false             # development: a watcher posts incident cards and investigates them
# DASHBOARD_AI_TOOLS=all                   # or core: fewer tools, for small models
# Budgets (per process, reset at midnight UTC): questions and tokens a day, tokens per run.
# DASHBOARD_AI_DAILY_QUESTIONS=200
# DASHBOARD_AI_DAILY_TOKENS=10000000       # an agent run re-sends its context each step: ~40-50k tokens a run
# DASHBOARD_AI_RUN_MAX_TOKENS=300000
# DASHBOARD_AI_MAX_ANSWER_TOKENS=8000      # one answer's length; a cut answer gets a Continue button
# A dollar cap instead (or as well): the model's USD per million tokens, from the provider's price list.
# DASHBOARD_AI_PRICE_IN=0.04
# DASHBOARD_AI_PRICE_OUT=0.55
# DASHBOARD_AI_DAILY_USD=1.00              # stop for the day at this estimate (needs both prices)
# OpenRouter (OpenAI-compatible, tool calling), e.g. a cheap fast model
# DASHBOARD_AI_PROVIDER=openai-compatible
# DASHBOARD_AI_BASE_URL=https://openrouter.ai/api/v1
# DASHBOARD_AI_MODEL=deepseek/deepseek-v4.1-flash   # or openai/gpt-6-luna, z-ai/glm-5.3-flash
# DASHBOARD_AI_REFERER=http://localhost:3000   # optional: OpenRouter's HTTP-Referer
# DASHBOARD_AI_TITLE="My app dev dashboard"    # optional: OpenRouter's X-Title (quote values with spaces)
# --- email: development always uses the dev mailbox; SMTP_URL is for production ---
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAILER=smtp                  # smtp | local | log: only to try real delivery from development (needs SMTP_URL)
# MAIL_FROM="My App <no-reply@example.com>"   # default: "<APP_NAME> <no-reply@localhost>"
# --- accounts (auth-core): required in production, at least 32 characters ---
# APP_SECRET_KEY=generate-with-openssl-rand-base64-48
# Who may create an account: open (anyone) or invite (app task auth_invite <email>). Default: DEFAULT_SIGNUP in src/config.rs.
# APP_AUTH_SIGNUP=open
# --- magic links (auth-magic-link): a link works only in the browser that asked for it ---
# APP_MAGIC_LINK_ANY_BROWSER=false
# --- jobs (.offrails/guides/jobs.md) ---
# APP_QUEUES=default:10,mailers:5,webhooks:3:30/1m   # name:limit[:rate per period]; limit is per node, rate is global
# APP_INLINE_WORKER=true        # run the worker inside `app serve` (default: true in development only)
# APP_JOBS_PRUNE_DAYS=7         # delete finished jobs after N days
# APP_JOBS_SHUTDOWN_GRACE=25    # seconds in-flight jobs get on SIGTERM (default 25, 3 in development; below the platform's kill timeout)
# APP_JOBS_NODE=web-1           # this process's name on the dashboard (default: random node-<hex>, never the hostname)
# --- jobs dashboard (/admin/jobs): open in development; elsewhere admins only ---
# APP_ADMIN_PASSWORD=          # 16+ characters: HTTP Basic for /admin/jobs when the app has no admin accounts. Unset in production: not mounted.
# samples: env
# --- logging ---
RUST_LOG=info,board=debug
LOG_FORMAT=pretty
